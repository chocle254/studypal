# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never put real values in this file or in the repo.

# NVIDIA Nemotron (key from https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Supabase (Project Settings > API): the project URL and the service_role key (server only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
