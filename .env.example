# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never put real values in this file or in the repo.

# The AI (any OpenAI-compatible provider). Groq is fast and has a free plan:
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b

# Or NVIDIA Nemotron (used only when the AI_* settings are empty; key from https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Supabase: the project URL and a server-side key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
